# SafeCircle — variáveis de ambiente (exemplo público)
# Copie para `.env` e ajuste os valores. NUNCA versione o arquivo `.env` real.

# Ambiente de execução da API
NODE_ENV=development
PORT=3000

# Conexão PostgreSQL (dev local self-contained criado por `pnpm db:start`)
DATABASE_URL=postgres://safecircle:safecircle@localhost:5432/safecircle

# Autenticação (Phase 1) — segredo do backend, NUNCA versionar valor real.
# Em produção é obrigatório (mínimo 32 caracteres). Em dev/test há um default seguro explícito.
JWT_ACCESS_SECRET=
# TTL do access token JWT (ex.: 15m, 1h).
JWT_ACCESS_TTL=15m
# Validade do refresh token, em dias.
REFRESH_TOKEN_TTL_DAYS=30

# Origens web permitidas (Phase 11) — allow-list explícita, separada por vírgula,
# no formato https://host[:porta]. Sem wildcard. Vale para CORS e para o
# handshake do WebSocket. Em produção é sempre estrita; em dev/test, definir a
# lista também ativa o modo estrito. O app nativo não envia Origin e não depende disto.
# (CORS_ORIGINS é o nome antigo e continua aceito.)
CORS_ALLOWED_ORIGINS=

# HSTS (Phase 11): ligue SOMENTE quando o HTTPS externo é garantido pelo
# ingress/proxy. Em dev HTTP deixe false, ou o navegador passa a recusar http://.
HSTS_ENABLED=false

# Proxy reverso (Phase 11): `false` (padrão), `true` ou o número de saltos
# confiáveis. Só confie em X-Forwarded-* atrás do seu próprio proxy.
TRUST_PROXY=false

# Notificações push (Phase 4) — a API envia via Expo Push API (https://exp.host).
# Token de acesso opcional da conta Expo (recomendado em produção, com
# "Enhanced Security for Push Notifications"). Segredo do backend: NUNCA versionar.
# Credenciais FCM/APNs ficam na conta Expo/EAS, nunca neste repositório.
EXPO_ACCESS_TOKEN=

# Observabilidade (Phase 9).
# /metrics só existe quando habilitado; desabilitado, a rota responde 404.
METRICS_ENABLED=false
# Quando definido, /metrics exige `Authorization: Bearer <token>` (mín. 16 chars).
# Segredo do backend: NUNCA versionar o valor real.
METRICS_TOKEN=
# Identificação da build nos logs de startup (valores públicos, não são secrets).
APP_VERSION=
GIT_SHA=
BUILD_DATE=

# Provedor de push (Phase 12): `expo` (padrão, obrigatório em produção) ou `noop`
# para E2E/staging sem credenciais — nunca chama a Expo, só marca como enviado.
PUSH_PROVIDER=expo

# E-mail transacional (Phase 13) — hoje só o convite para grupo.
# `noop` (padrão): registra e descarta; o convite continua visível no app.
# `smtp`: funciona com Resend, SendGrid, Amazon SES, Postmark, Gmail etc.
# SMTP_PASSWORD é SEGREDO: nunca versionar, nunca colar em chat.
EMAIL_PROVIDER=noop
SMTP_HOST=
SMTP_PORT=587
# true apenas com TLS implícito (porta 465); em 587 o transporte faz STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=SafeCircle <nao-responda@safecircle.invalid>
# Deep link público usado no e-mail (sem token, sem identificador pessoal).
APP_DEEP_LINK=safecircle://

# Ambiente E2E (Phase 12). Ignorados em produção: lá o perfil é sempre real e
# o intervalo tem piso de 1 s. Em E2E: RATE_LIMIT_PROFILE=relaxed e
# SCHEDULER_POLL_INTERVAL_MS=1000 para não esperar 15 s por um vencimento.
RATE_LIMIT_PROFILE=
SCHEDULER_POLL_INTERVAL_MS=15000

# Outbox transacional (Phase 10) — push, realtime e auditoria são gravados na
# mesma transação do domínio e entregues por um worker persistente.
# Desligar o worker NÃO perde efeitos: eles ficam pendentes no banco, sem entrega.
OUTBOX_ENABLED=true
# Intervalo de polling do worker em ms (100–60000).
OUTBOX_POLL_INTERVAL_MS=500
# Eventos reivindicados por ciclo (1–500).
OUTBOX_BATCH_SIZE=50
# Entregas simultâneas por ciclo (1–50).
OUTBOX_CONCURRENCY=5
# Lease do claim em ms: PROCESSING mais antigo que isso volta para a fila (5000–600000).
OUTBOX_LEASE_MS=60000

# URL pública consumida pelo app mobile.
# Tudo em EXPO_PUBLIC_* é considerado público: nunca coloque segredos aqui.
EXPO_PUBLIC_API_URL=http://localhost:3000
