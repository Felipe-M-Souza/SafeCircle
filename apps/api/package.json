{
  "name": "@safecircle/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "location:cleanup": "tsx src/scripts/location-cleanup.ts",
    "checkin:cleanup": "tsx src/scripts/checkin-cleanup.ts",
    "journey:cleanup": "tsx src/scripts/journey-cleanup.ts",
    "audit:cleanup": "tsx src/scripts/audit-cleanup.ts",
    "outbox:status": "tsx src/scripts/outbox-cli.ts status",
    "outbox:list-dead": "tsx src/scripts/outbox-cli.ts list-dead",
    "outbox:retry-dead": "tsx src/scripts/outbox-cli.ts retry-dead",
    "outbox:cleanup": "tsx src/scripts/outbox-cli.ts cleanup",
    "privacy:cleanup": "tsx src/scripts/privacy-cleanup.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "11.3.0",
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/ws": "8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "ws": "8.21.3"
  }
}
