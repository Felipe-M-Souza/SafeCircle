{
  "expo": {
    "name": "SafeCircle",
    "slug": "safecircle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "safecircle",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safecircle.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O SafeCircle pode usar sua localização durante um alerta ou trajeto para ajudar seu grupo de confiança a encontrar você. A localização só é compartilhada enquanto o aplicativo está aberto.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.safecircle.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "usesCleartextTraffic": false,
      "allowBackup": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCI9wx5iuJgOQN40n3iX2p-dZKXDtxBLLQ"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O SafeCircle pode usar sua localização durante um alerta para ajudar seu grupo de confiança a encontrar você.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F87171",
          "defaultChannel": "emergency"
        }
      ]
    ],
    "extra": {
      "googleMapsApiKeyConfigured": true
    }
  }
}
