{
  "name": "safecircle",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "SafeCircle — rede privada de segurança para grupos de confiança (monorepo).",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "dev:api": "pnpm --filter @safecircle/api dev",
    "dev:mobile": "pnpm --filter @safecircle/mobile web",
    "db:start": "bash scripts/db-start.sh",
    "db:stop": "bash scripts/db-stop.sh",
    "db:check": "pnpm --filter @safecircle/api run db:check",
    "location:cleanup": "pnpm --filter @safecircle/api run location:cleanup",
    "checkin:cleanup": "pnpm --filter @safecircle/api run checkin:cleanup",
    "journey:cleanup": "pnpm --filter @safecircle/api run journey:cleanup",
    "audit:cleanup": "pnpm --filter @safecircle/api run audit:cleanup",
    "outbox:status": "pnpm --filter @safecircle/api run outbox:status",
    "outbox:list-dead": "pnpm --filter @safecircle/api run outbox:list-dead",
    "outbox:retry-dead": "pnpm --filter @safecircle/api run outbox:retry-dead",
    "outbox:cleanup": "pnpm --filter @safecircle/api run outbox:cleanup",
    "privacy:cleanup": "pnpm --filter @safecircle/api run privacy:cleanup",
    "security:audit": "pnpm audit --audit-level high",
    "e2e:api": "pnpm --filter @safecircle/api run e2e",
    "e2e:seed": "pnpm --filter @safecircle/api run e2e:seed",
    "e2e:reset": "pnpm --filter @safecircle/api run e2e:reset",
    "e2e:mobile": "pnpm --filter @safecircle/mobile run e2e",
    "smoke:api": "pnpm --filter @safecircle/api run smoke",
    "release:blockers": "node scripts/release-blockers-check.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
